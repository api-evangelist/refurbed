        },
        "id": {
          "type": "string",
          "format": "int64",
          "description": "Primary key of the product to get.",
          "required": [
            "id"
          ]
        },
        "back_link": {
          "type": "string",
          "x-nullable": true,
          "description": "URL linking back to partner's site.\n\nIf provided, it is used to populate a query parameter for product\nbuybox link."
        }
      },
      "required": [
        "site_market_code",
        "id"
      ]
    },
    "GetProductResponse": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/Product",
