        }
      }
    },
    "Instance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64",
          "description": "Primary key."
        },
        "name": {
          "type": "string",
          "description": "Human-readable name."
        },
        "product_id": {
          "type": "string",
          "format": "int64",
          "description": "Identifier of product this instance is linked with."
        },
        "category_id": {
          "type": "string",
          "format": "int64",
          "description": "Identifier of category this instance is linked with."
        },
        "category_path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable names of category hierarchy path (e.g. [\"Smartphones\", \"Apple\"])."
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Attribute"
          },
          "description": "List of attributes assigned to this instance including product attributes."
        },
        "medias": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Media"
          },
          "description": "List of media assigned to this instance including the instance's product\nmedia."
        },
        "buybox": {
          "$ref": "#/definitions/Buybox",
          "description": "Buybox data, defines the price and conditions (grading, warranty) by which\nthis instance is sold."
        }
