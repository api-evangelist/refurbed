    "GetInstanceRequest": {
      "type": "object",
      "properties": {
        "site_market_code": {
          "type": "string",
          "description": "The code of a site market where the instance is sold.",
          "required": [
            "site_market_code"
          ]
        },
        "id": {
          "type": "string",
          "format": "int64"
        },
        "gtin": {
          "type": "string",
          "description": "A GTIN-8, GTIN-12 or GTIN-13. Note that EAN-13 and UPC-A codes are GTINs."
        },
        "back_link": {
          "type": "string",
          "x-nullable": true,
          "description": "URL linking back to partner's site.\n\nIf provided, it is used to populate a query parameter for instance\nbuybox link."
        }
      },
      "required": [
        "site_market_code"
      ]
    },
    "GetInstanceResponse": {
      "type": "object",
      "properties": {
