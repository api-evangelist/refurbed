            "site_market_code"
          ]
        },
        "product_id": {
          "type": "string",
          "format": "int64",
          "description": "Identifier of product instances are linked with.",
          "required": [
            "product_id"
          ]
        },
        "back_link": {
          "type": "string",
          "x-nullable": true,
          "description": "URL linking back to partner's site.\n\nIf provided, it is used to populate a query parameter for each\ninstance buybox link."
        }
